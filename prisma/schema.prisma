generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  password             String
  name                 String
  phone                String?
  avatar               String?
  isActive             Boolean             @default(true)
  emailVerified        Boolean             @default(false)
  role                 UserRole            @default(USER)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  businessName         String?
  businessCategory     String?
  businessDescription  String?
  businessAddress      String?
  businessPhone        String?
  businessWebsite      String?
  storeName            String?             @map("store_name")
  storeLogo            String?             @map("store_logo")
  storeImage           String?             @map("store_image")
  storeAddress         String?             @map("store_address")
  storePhone           String?             @map("store_phone")
  primaryColor         String?             @map("primary_color")
  secondaryColor       String?             @map("secondary_color")
  thirdColor           String?             @map("third_color")
  aiProvider           String?             @map("ai_provider")
  aiModel              String?             @map("ai_model")
  aiApiKey             String?             @map("ai_api_key")
  aiTemperature        Float?              @map("ai_temperature")
  aiMaxTokens          Int?                @map("ai_max_tokens")
  aiToneOfVoice        String?             @map("ai_tone_of_voice")
  aiTargetAudience     String?             @map("ai_target_audience")
  aiPlatforms          String[]            @map("ai_platforms")
  aiCustomInstructions String?             @map("ai_custom_instructions")
  activityLogs         ActivityLog[]
  aiAssistants         AiAssistant[]
  contentGenerations   ContentGeneration[]
  imageGenerations     ImageGeneration[]
  subscriptions        Subscription[]
  transactions         Transaction[]
  userSessions         UserSession[]

  @@map("users")
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  packageId    String?
  plan         SubscriptionPlan
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime
  endDate      DateTime
  monthlyPrice Int
  yearlyPrice  Int?
  autoRenew    Boolean            @default(true)
  usageResetAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  package      Package?           @relation(fields: [packageId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model ContentGeneration {
  id               String           @id @default(cuid())
  userId           String
  type             ContentType
  prompt           String
  generatedContent String?
  promptTokens     Int?
  completionTokens Int?
  cost             Float?
  status           GenerationStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("content_generations")
}

model ImageGeneration {
  id         String           @id @default(cuid())
  userId     String
  prompt     String
  imageUrl   String?
  imageStyle String?
  imageSize  String?
  cost       Float?
  status     GenerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("image_generations")
}

model AiAssistant {
  id         String        @id @default(cuid())
  userId     String
  sessionId  String?
  message    String
  response   String?
  tokensUsed Int?
  cost       Float?
  type       AssistantType @default(CHAT)
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_assistants")
}

model Package {
  id                    String         @id @default(cuid())
  name                  String
  description           String
  price                 Int
  yearlyPrice           Int?
  currency              String         @default("USD")
  features              Json
  isActive              Boolean        @default(true)
  maxContentGenerations Int?
  maxImageGenerations   Int?
  imagesPerGeneration   Int            @default(2)
  duration              Int            @default(30)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
  transactions          Transaction[]

  @@map("packages")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  packageId      String
  amount         Int
  currency       String            @default("USD")
  status         TransactionStatus @default(PENDING)
  paymentMethod  String?
  paymentGateway String?
  externalId     String?
  type           TransactionType   @default(SUBSCRIPTION)
  period         BillingPeriod     @default(MONTHLY)
  metadata       Json?
  failureReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  package        Package           @relation(fields: [packageId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model ActivityLog {
  id           String       @id @default(cuid())
  userId       String
  activityType ActivityType
  action       String
  description  String
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  success      Boolean      @default(true)
  errorMessage String?
  duration     Int?
  timestamp    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionPlan {
  FREE
  TRIAL
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum ContentType {
  CAPTION
  EMAIL
  BLOG_POST
  PRODUCT_DESCRIPTION
  MARKETING_PLAN
  HASHTAGS
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssistantType {
  CHAT
  CONTENT_HELP
  MARKETING_ADVICE
  BUSINESS_TIPS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionType {
  SUBSCRIPTION
  RENEWAL
  UPGRADE
  DOWNGRADE
  ONE_TIME
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum ActivityType {
  LOGIN
  LOGOUT
  CONTENT_GENERATION
  IMAGE_GENERATION
  PROFILE_UPDATE
  SETTINGS_UPDATE
  PASSWORD_CHANGE
  SUBSCRIPTION_CHANGE
  API_ACCESS
  DOWNLOAD
  UPLOAD
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}
